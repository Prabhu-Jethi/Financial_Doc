# ==============================================================================
# DOCINTEL FULL-STACK ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Authority & Auth (Required for both Frontend and Backend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase JWT Secret for direct symmetric verification (Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# 2. Database & pgvector (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Transaction pooler connection string (port 6543) or direct session (port 5432)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. LLM API Key (Experiential Labs gpt-6-luna or OpenAI compatible)
# ------------------------------------------------------------------------------
EXPLABS_API_KEY=your-explabs-api-key-here
HF_TOKEN=your-huggingface-token-if-needed

# ------------------------------------------------------------------------------
# 4. Service Discovery
# ------------------------------------------------------------------------------
# When running locally: http://localhost:8000
# When running in Docker Compose: automatically resolves to http://backend:8000
FASTAPI_BASE_URL=http://localhost:8000
